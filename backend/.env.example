# ---------------------------------------------------------------------------
# MemoryOps backend configuration TEMPLATE.
#
# Copy this file to backend/.env and fill in your own keys:
#     PowerShell:  Copy-Item backend/.env.example backend/.env
#
# backend/.env is git-ignored. NEVER commit real keys, and never put real keys
# in this .env.example template — it is tracked by git.
#
# After editing backend/.env, RESTART the backend (uvicorn reload watches .py
# files only, not .env). GET /api/health reports what was loaded.
# ---------------------------------------------------------------------------

# --- Groq (LLM reasoning) --------------------------------------------------
# Get a key at https://console.groq.com/keys  (keys look like gsk_...)
GROQ_API_KEY=
# Recommended: openai/gpt-oss-120b (fast, cheap, supports JSON mode).
# Other production options: openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# --- Hindsight by Vectorize (memory) --------------------------------------
# Get a key at https://hindsight.vectorize.io  (keys look like hsk_...)
HINDSIGHT_API_KEY=
# Hindsight Cloud. For a self-hosted server use http://localhost:8888
HINDSIGHT_URL=https://api.hindsight.vectorize.io

# --- Optional tuning ------------------------------------------------------
# Memory bank that holds the incident experiences.
HINDSIGHT_BANK_ID=memoryops-incidents
# How many recalled memories to pass to the LLM.
HINDSIGHT_RECALL_LIMIT=5
HINDSIGHT_TIMEOUT_SECONDS=45
GROQ_TIMEOUT_SECONDS=60
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
LOG_LEVEL=INFO
